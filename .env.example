# Optional browser override. Leave empty when auto-detection works.
# CHATGPT_WEB_CHROME=/absolute/path/to/chrome

# Minimum intervals, not a guarantee against rate limits. Increase if needed.
CHATGPT_WEB_SEND_INTERVAL_MS=5000
CHATGPT_WEB_CONVERSATION_CHANGE_INTERVAL_MS=5000
CHATGPT_WEB_POST_RESPONSE_CONVERSATION_COOLDOWN_MS=5000
CHATGPT_WEB_PAGE_INTERACTION_INTERVAL_MS=1000
CHATGPT_WEB_SITE_ACTION_INTERVAL_MS=5000
CHATGPT_WEB_PAGE_STARTUP_DELAY_MS=6000
CHATGPT_WEB_POST_BREAKER_COOLDOWN_MS=300000
CHATGPT_WEB_HISTORY_QUIET_PERIOD_MS=300000

# Avoid extra temporary chats and test prompts by default.
CHATGPT_WEB_PROBE_ENABLED=false
# Optional extra reload BEFORE opening a new chat. Sending already reloads.
CHATGPT_WEB_REFRESH_BEFORE_NEW_CHAT=false

# Experimental probe settings below only apply when explicitly enabled.
CHATGPT_WEB_DEFAULT_TIER=极高
CHATGPT_WEB_PRO_TIER=Pro
CHATGPT_WEB_PROBE_PROMPT=你是什么模型？
CHATGPT_WEB_PROBE_ACCEPT_ID=gpt-5.6-pro
CHATGPT_WEB_PROBE_FALLBACK_ID=gpt-5.5-mini
CHATGPT_WEB_PROBE_ACCEPT_PATTERN=gpt\s*[- ]?5[.．]6\s*[- ]?pro|5[.．]6\s*[- ]?pro
CHATGPT_WEB_PROBE_FALLBACK_PATTERN=gpt\s*[- ]?5[.．]5\s*[- ]?mini|5[.．]5\s*[- ]?mini
CHATGPT_WEB_PRO_RECHECK_AFTER_CLOSE_MS=10800000
CHATGPT_WEB_MAX_CONVERSATION_TURNS=40
# Optional: point this at a checked-out research repository docs directory.
# CHATGPT_WEB_CONTEXT_ARCHIVE_DIR=/absolute/path/to/repo/docs/research/chatgpt-web
